# Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
LOG_LEVEL=info

# PostgreSQL and Redis
DATABASE_URL=postgresql://syarat:syarat@localhost:5432/syarat?schema=public
REDIS_URL=redis://localhost:6379

# Authentication
JWT_ACCESS_SECRET=replace-with-a-32-character-minimum-development-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_HMAC_SECRET=replace-with-a-separate-32-character-minimum-development-secret
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Object storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=syarat-local
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_PUBLIC_BASE_URL=http://localhost:9000/syarat-local

# Availability jobs
AVAILABILITY_CONFIRMATION_DAYS=7
AVAILABILITY_GRACE_DAYS=3
